{
  "name": "dayflow-sync",
  "main": "src/cors-worker.mjs",
  "compatibility_date": "2026-10-07",
  "workers_dev": true,
  "durable_objects": { "bindings": [
    { "name": "GROUPS", "class_name": "SyncGroup" },
    { "name": "DIRECTORY", "class_name": "PairDirectory" },
    { "name": "ORIGINAL_GROUPS", "class_name": "OriginalSyncGroup" },
    { "name": "ORIGINAL_DIRECTORY", "class_name": "OriginalDirectory" }
  ] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SyncGroup", "PairDirectory"] },{ "tag": "v2", "new_sqlite_classes": ["OriginalSyncGroup", "OriginalDirectory"] }],
  "observability": { "enabled": false }
}
